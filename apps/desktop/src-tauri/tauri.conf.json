{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code-Ready V2",
  "version": "0.0.0",
  "identifier": "com.codeready.v2",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Code-Ready V2",
        "width": 960,
        "height": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "targets": ["app", "nsis"]
  }
}
